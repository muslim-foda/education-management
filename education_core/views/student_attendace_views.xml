<odoo>
    <record id="student_attendance_view_list" model="ir.ui.view">
        <field name="name">student.list</field>
        <field name="model">student.attendance</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id" />
            </list>
        </field>
    </record>

    <record id="student_attendance_view_form" model="ir.ui.view">
        <field name="name">student.form</field>
        <field name="model">student.attendance</field>
        <field name="arch" type="xml">
            <form string="Student Attendance">
                <header invisible="id == False">
                    <button
                        name="lock_attendance"
                        string="Lock"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'new' or id == False "
                        confirm="Are you sure you want to lock this attendance?"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label for="student_id" string="Student" />
                            <br />
                            <field
                                name="student_id"
                                options="{'no_create': True}"
                                readonly="state == 'lock'"
                            />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="attendance_date" readonly="state == 'lock'" />
                            <field name="check_in" readonly="state == 'lock'" />
                            <!-- <field name="current_academic_year_id"/> -->
                        </group>
                        <group>
                            <field name="attendance_state" readonly="state == 'lock'" />
                            <field
                                name="company_id"
                                options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"
                            />
                            <field name="total_hours_spent" widget="float_time" />
                        </group>
                    </group>
                    <notebook>
                        <!-- <page name="class_attendance" string="Class Attendance">
                                <field name="class_attendance_ids" readonly="state == 'lock'" context="{'default_student_id':student_id,'default_class_date':attendance_date}">
                                    <list editable="bottom">
                                        <field name="student_id" optional="hide" readonly="1"/>
                                        <field name="class_date" optional="hide"/>
                                        <field name="class_id" options="{'no_create': True}"/>
                                        <field name="state" widget="badge" decoration-danger="state=='absent'" decoration-success="state=='present'"/>
                                        <field name="class_ids_domain" column_invisible="1"/>
                                    </list>
                                </field>
                            </page> -->
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

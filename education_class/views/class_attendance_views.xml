<odoo>
    <record id="view_class_attendance_list" model="ir.ui.view">
        <field name="name">class_attendance</field>
        <field name="model">class.attendance</field>
        <field name="arch" type="xml">
            <list string="Class">
                <field name="student_id" />
            </list>
        </field>
    </record>

    <record id="view_class_attendance_form" model="ir.ui.view">
        <field name="name">class_attendance</field>
        <field name="model">class.attendance</field>
        <field name="arch" type="xml">
            <form string="Class Attendance">
                <sheet>
                    <!-- <div class="oe_button_box" name="button_box">
                            <button name="466" type="action" class="oe_stat_button">
                                    <i class="o_button_icon fa fa-clock-o" title="Attendance"/>
                                    <div class="o_stat_info">
                                        <span class="o_stat_text">
                                            Attendance
                                        </span>
                                    </div>
                            </button>
                        </div> -->
                    <div class="oe_title">
                        <h1>
                            <label for="student_id" string="Student" />
                            <br />
                            <field name="student_id" options="{'no_create': True}" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="class_id" options="{'no_create': True}" />
                            <field name="state" />
                            <field
                                name="company_id"
                                options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"
                            />
                        </group>
                        <group>
                            <field name="class_date" />
                            <field
                                name="attendance_tag_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color', 'no_create_edit': True}"
                            />
                            <!-- <field name="class_ids_domain" invisible="1"/> -->
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="education_class_attendance_action" model="ir.actions.act_window">
        <field name="name">class.attendance</field>
        <field name="res_model">class.attendance</field>
        <field name="view_mode">form</field>
    </record>
</odoo>

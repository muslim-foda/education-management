<odoo>
    <record id="student_view_form" model="ir.ui.view">
        <field name="name">lesson.plans.form</field>
        <field name="model">lesson.plans</field>
        <field name="arch" type="xml">
            <form string="Lesson Plan">
                <header>
                    <button
                        name="approve_lesson_plan"
                        string="Approve"
                        type="object"
                        class="oe_highlight"
                        invisible="(state != 'draft') or (id == False) or context.get('from_grade_subject')"
                        confirm="Are you sure you want to approve this lesson plan?"
                    />
                    <button
                        name="cancel_lesson_plan"
                        string="Cancel"
                        type="object"
                        class="oe_highlight"
                        invisible="(state != 'draft') or (id == False) or context.get('from_grade_subject')"
                        confirm="Are you sure you want to cancel this lesson plan?"
                    />
                    <button
                        name="reset_lesson_plan"
                        string="Reset"
                        type="object"
                        class="oe_highlight"
                        invisible="(state == 'draft') or (id == False) or context.get('from_grade_subject')"
                        confirm="Are you sure you want to reset this lesson plan?"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,approve"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                placeholder="Ex. LP-001"
                                readonly="state in ('approve','cancel')"
                            />
                        </h1>
                    </div>
                    <group name="plan_details1">
                        <group>
                            <field
                                name="grade_id"
                                readonly="state in ('approve','cancel')"
                                options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"
                            />
                            <!-- <field name="section_id" readonly="state in ('approve','cancel')" invisible="not section_visibility" options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"/> -->
                            <field
                                name="subject_id"
                                readonly="state in ('approve','cancel')"
                                options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"
                            />
                            <field
                                name="plan_visibility"
                                widget="radio"
                                readonly="state in ('approve','cancel')"
                            />
                            <!-- <field name="grade_id_domain" invisible="1"/> -->
                        </group>
                        <group name="plan_details2">
                            <field name="responsible_id" readonly="1" />
                            <field
                                name="company_id"
                                options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"
                            />
                        </group>
                    </group>
                    <group string="Lesson Plan">
                        <field
                            colspan="2"
                            name="description"
                            nolabel="1"
                            placeholder="Write your lesson plans here."
                            readonly="state in ('approve','cancel')"
                        />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="lesson_plans_action" model="ir.actions.act_window">
        <field name="name">lesson.plans</field>
        <field name="res_model">lesson.plans</field>
        <field name="view_mode">form</field>
    </record>
</odoo>

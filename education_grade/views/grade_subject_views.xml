<odoo>
    <record id="view_grade_subject_list" model="ir.ui.view">
        <field name="name">grade_subject</field>
        <field name="model">grade.subject</field>
        <field name="arch" type="xml">
            <list string="Grade">
                <field name="subject" />
            </list>
        </field>
    </record>

    <record id="view_grade_subject_form" model="ir.ui.view">
        <field name="name">grade.subject.form</field>
        <field name="model">grade.subject</field>
        <field name="arch" type="xml">
            <form string="Grade subject">
                <sheet>
                    <group>
                        <group>
                            <field name="subject" />
                            <field name="optional_choice" widget="checkbox" />
                            <field name="passing_percent" />

                            <field
                                name="company_id"
                                options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"
                            />
                        </group>
                        <group>
                            <field name="grade_id" />
                            <!-- <field
                                name="section_id"
                                invisible="not section_visibility"
                                options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"
                            /> -->
                            <field name="credit_value" />

                            <field name="subject_code" />
                            <!-- <field name="scale_id" invisible="1" /> -->
                        </group>
                    </group>
                    <notebook>
                        <page string="Teachers">
                            <field name="teacher_ids" readonly="1" force_save="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="grade_subject_action" model="ir.actions.act_window">
        <field name="name">grade_subject</field>
        <field name="res_model">grade.subject</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

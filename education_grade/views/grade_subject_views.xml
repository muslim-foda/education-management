<odoo>
    <record id="view_grade_subject_list" model="ir.ui.view">
        <field name="name">grade_subject</field>
        <field name="model">grade_subject</field>
        <field name="arch" type="xml">
            <list string="Grade">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="grade_subject_action" model="ir.actions.act_window">
        <field name="name">grade_subject</field>
        <field name="res_model">grade_subject</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
